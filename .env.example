# ===================================================
# EXPERIENCE LIFE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your values.
# DO NOT commit real secrets or production keys here.
# ===================================================

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/catelog?retryWrites=true&w=majority

# Cloudinary Asset Storage (Optional: Falls back to local public/uploads/ if omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email System (Nodemailer Gmail SMTP)
# Create an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
CONTACT_RECEIVER_EMAIL=your_inbox@gmail.com

# Authentication & Security
AUTH_SECRET=generate-a-secure-random-32-byte-secret-here
ADMIN_EMAIL=admin@experiencelife.design
ADMIN_PASSWORD=SetSecureAdminPasswordHere#2026

# Public Canonical URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
